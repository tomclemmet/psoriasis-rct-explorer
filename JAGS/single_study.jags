model {
  # *** PROGRAM STARTS
  for (k in 1:2) {                                                              # LOOP THROUGH ARMS
    p[k, 1] <- 1                                                                # Pr(PASI >0)
    for (j in 1:(nc - 1)) {                                                     # LOOP THROUGH CATEGORIES
      r[k, j] ~ dbin(q[k, j], n[k, j])                                          # binomial likelihood
      q.raw[k, j] <- 1 - (p[k, C[j + 1]] /                                      # conditional probabilities
        max(p[k, C[j]], 1e-14)) 
      q[k, j] <- max(1e-12, min(1 - 1e-12, q.raw[k, j]))
      theta[k, j] <- mu - d + z[C[j + 1] - 1]
    }
    for (j in 2:nc) {                                                           # LOOP THROUGH CATEGORIES
      p[k, C[j]] <- 1 - phi.adj[k, j]                                           # link function
      # adjust link function phi(x) for extreme values that can give numerical errors
      phi.adj[k, j] <- step(8 + theta[k, j - 1]) * 
        (step(theta[k, j - 1] - 8) +
           step(8 - theta[k, j - 1]) * phi(theta[k, j - 1]))
    }
  }
  z[1] <- 0                                                                     # set z50=0
  for (j in 2:nc) {                                                             # Set priors for z, for any number of categories
    z.aux[j] ~ dunif(0,5)                                                       # priors
    z[j] <- z[j-1] + z.aux[j]                                                   # ensures z[j]~Uniform(z[j-1], z[j-1]+5)
  }
  d ~ dnorm(0, .5)                                                              # vague priors for treatment effects
  mu ~ dnorm(0, .5)  
  # *** PROGRAM ENDS 
}
